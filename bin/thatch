#!/usr/bin/env bun

import { homedir } from "node:os";
import { join, resolve } from "node:path";
import pkg from "../package.json" with { type: "json" };
import { ThatchDB } from "../src/db";
import { detectRepo } from "../src/git";
import { BgeEmbeddingModel } from "../src/embeddings";
import { hygieneReport } from "../src/hygiene";
import { claudeSessionStartReminder } from "../src/prompts";
import { setupClaudeCode, setupCursor } from "../src/setup";
import { resolveOpencodeDbPath, SessionDB, partToTimelineEntry, partToTranscriptEntries, partToFullJson, messageToFullJson, type SessionPart } from "../src/session-db";
import { chatTailDiff, formatChatTailEvent, isStale, CHAT_STALE_MINUTES } from "../src/chat";

const configHome = process.env.XDG_CONFIG_HOME ?? join(homedir(), ".config");
const dbPath = process.env.THATCH_DB_PATH ?? join(configHome, "thatch", "thatch.db");
const db = new ThatchDB(dbPath);

const [command, ...args] = process.argv.slice(2);

function usage(): never {
  console.error(`USAGE
  thatch --version, -v             Print version and exit
  thatch stores                    List all stores
  thatch list   [store]            List memory labels in a store  
  thatch show   <label> [store]    Display a memory by label
  thatch forget <label> [store]    Remove a memory by label
  thatch search <query> [store]    Semantic search (cosine similarity)
  thatch mcp                       Start the stdio MCP server (for Claude Code, Cursor, etc.)
  thatch reminder [--json]         Print session-start reminder (for SessionStart hook)
  thatch hygiene                   Print the hygiene report (standalone)
  thatch prime                     Prime project memory (runs the primer skill via opencode, cursor, or claude)
  thatch buffer-batch              Append a PostToolBatch payload to the queue (Claude Code hook only)
  thatch buffer-tool               Append a single postToolUse interaction to the queue (Cursor hook only)
  thatch flush-tools [--json]      Peek the queue + print an extraction nudge (hook only)
  thatch flush-predictions [--json] Query predictions for the prompt (hook only)
  thatch setup --claude [--cursor] [--local|--global]
                                   Install config + instructions + hooks + skills
  thatch session list -s <id> [--after T] [--before T]
                                   JSONL timeline of a session's parts (one line per part)
  thatch session get --id <part_id|msg_id>
                                   Full JSON of one part (tool parts include their output)
                                   or one message with all its parts
  thatch session transcript -s <id>
                                   Full conversation as OpenAI chat-completions JSONL
  thatch session search <query> [--session <id>] [--regex] [--limit N]
                                   JSONL of matching parts across sessions (decoded content)
  thatch chat list                 Registered chat sessions: name, age, project, topic
  thatch chat tail [--once]        Follow cross-session chat: sent and read events
                                   (--once prints current state and exits)

Stores default to the repo detected from git remote. Use "global" for the
global store. Use "all" with search to search project + global together.`);
  process.exit(1);
}

async function defaultStore(): Promise<string> {
  try {
    return await detectRepo();
  } catch {
    return "unknown";
  }
}

/**
 * Emits the nudge output, prepending a version warning if present. The
 * warning goes first so the LLM sees it before the nudge text. Used by
 * flush-tools to surface version skew and update-available notices on
 * every UserPromptSubmit, regardless of which tier fired.
 */
function emit(output: string, versionWarning: string | null, isJson: boolean): void {
  if (versionWarning) {
    output = `[thatch] ${versionWarning}\n\n${output}`;
  }
  if (isJson) console.log(JSON.stringify({ additional_context: output }));
  else console.log(output);
}

/** Resolve the project directory from host-specific env vars or cwd. */
function projectDir(): string {
  return process.env.CURSOR_PROJECT_DIR ?? process.env.CLAUDE_PROJECT_DIR ?? process.cwd();
}

// ---------------------------------------------------------------------------
// session subcommand group - read-only archaeology on the opencode db
// ---------------------------------------------------------------------------

/** Parses an ISO timestamp or epoch-milliseconds value into epoch ms. */
function parseTimeBound(value: string, flag: string): number {
  const asNum = Number(value);
  if (Number.isFinite(asNum) && value !== "") return asNum;
  const parsed = Date.parse(value);
  if (Number.isNaN(parsed)) {
    console.error(`error: ${flag} expects an ISO timestamp or epoch ms, got "${value}"`);
    process.exit(1);
  }
  return parsed;
}

/** Reads a flag's value (-flag value or --flag=value forms). */
function flagValue(flags: string[], ...names: string[]): string | undefined {
  for (let i = 0; i < flags.length; i++) {
    for (const name of names) {
      if (flags[i] === name) return flags[i + 1];
      if (flags[i]?.startsWith(`${name}=`)) return flags[i]!.slice(name.length + 1);
    }
  }
  return undefined;
}

function openSessionDb(): SessionDB {
  const path = resolveOpencodeDbPath();
  if (!path) {
    console.error(
      "error: no opencode database found. The session commands inspect the\n" +
        "session history of the opencode host; other hosts (Claude Code, Cursor)\n" +
        "have no such database. Set OPENCODE_DB to point at an opencode.db file.",
    );
    process.exit(1);
  }
  return new SessionDB(path);
}

async function sessionCommand(rest: string[]): Promise<void> {
  const [sub, ...restArgs] = rest;
  const sessionID = flagValue(restArgs, "-s", "--session");
  const after = flagValue(restArgs, "--after");
  const before = flagValue(restArgs, "--before");

  const db = openSessionDb();
  try {
    switch (sub) {
      case "list": {
        if (!sessionID) {
          console.error("error: session list requires -s/--session <session id>");
          process.exit(1);
        }
        const parts = db.listParts(
          sessionID,
          after ? parseTimeBound(after, "--after") : undefined,
          before ? parseTimeBound(before, "--before") : undefined,
        );
        for (const part of parts) console.log(JSON.stringify(partToTimelineEntry(part)));
        break;
      }

      case "get": {
        const id = flagValue(restArgs, "--id");
        if (!id) {
          console.error("error: session get requires --id <part_id|msg_id>");
          process.exit(1);
        }
        if (id.startsWith("msg_")) {
          const message = db.getMessage(id);
          if (!message) {
            console.error(`error: no message "${id}" in ${db.path}`);
            process.exit(1);
          }
          console.log(JSON.stringify(messageToFullJson(message), null, 2));
        } else {
          const part = db.getPart(id);
          if (!part) {
            console.error(`error: no part "${id}" in ${db.path}`);
            process.exit(1);
          }
          console.log(JSON.stringify(partToFullJson(part), null, 2));
        }
        break;
      }

      case "transcript": {
        if (!sessionID) {
          console.error("error: session transcript requires -s/--session <session id>");
          process.exit(1);
        }
        for (const message of db.listMessages(sessionID)) {
          for (const entry of partToTranscriptEntries(message.role, message.parts)) {
            console.log(JSON.stringify(entry));
          }
        }
        break;
      }

      case "search": {
        // Positional = args not preceded by a value-taking flag. Values like
        // "50" or a session id don't start with "-", so predecessor checks
        // are the only reliable discriminator.
        const valueFlags = new Set(["-s", "--session", "--limit"]);
        const positional = restArgs.filter((a, i) => !a.startsWith("-") && !valueFlags.has(restArgs[i - 1] ?? ""));
        const query = positional[0];
        if (!query) {
          console.error("error: session search requires a query (substring, or regex with --regex)");
          process.exit(1);
        }
        const limit = flagValue(restArgs, "--limit");
        const matches = db.search(query, {
          regex: restArgs.includes("--regex"),
          sessionID,
          limit: limit ? parseInt(limit, 10) : undefined,
        });
        // Titles let a cross-session result list be triaged without a
        // second lookup per hit. Sessions are cached - matches cluster.
        const titles = new Map<string, string | null>();
        for (const part of matches) {
          if (!titles.has(part.sessionId)) {
            titles.set(part.sessionId, db.getSession(part.sessionId)?.title ?? null);
          }
          const entry: Record<string, unknown> = {
            session_id: part.sessionId,
            session_title: titles.get(part.sessionId),
            ...partToTimelineEntry(part),
          };
          console.log(JSON.stringify(entry));
        }
        break;
      }

      default:
        usage();
    }
  } finally {
    db.close();
  }
}

// ---------------------------------------------------------------------------
// chat subcommand group - read-only window on the cross-session chat
// ---------------------------------------------------------------------------

/** "2m ago", "3h ago", "5d ago" - human-readable age for the chat roster. */
function humanAge(iso: string, now = Date.now()): string {
  const seconds = Math.max(0, Math.floor((now - Date.parse(iso)) / 1000));
  if (Number.isNaN(seconds)) return "unknown age";
  if (seconds < 60) return `${seconds}s ago`;
  const minutes = Math.floor(seconds / 60);
  if (minutes < 60) return `${minutes}m ago`;
  if (minutes < 24 * 60) return `${Math.floor(minutes / 60)}h ago`;
  return `${Math.floor(minutes / (24 * 60))}d ago`;
}

async function chatCommand(rest: string[]): Promise<void> {
  const [sub, ...restArgs] = rest;

  switch (sub) {
    case "list": {
      const sessions = db.listChatSessions();
      if (sessions.length === 0) {
        console.log("No sessions registered. Sessions join with thatch_chat_register from opencode.");
        break;
      }
      for (const s of sessions) {
        // Same staleness convention as the chat_list tool: an age past the
        // threshold means the session's host process is probably gone.
        const liveness = isStale(s, CHAT_STALE_MINUTES) ? "STALE" : "fresh";
        const parts = [
          s.name,
          `(${humanAge(s.last_seen)})`,
          liveness,
          `project:${s.project ?? "unknown"}`,
        ];
        if (s.topic) parts.push(s.topic);
        console.log(parts.join("  "));
      }
      break;
    }

    case "tail": {
      const onceOnly = restArgs.includes("--once");
      // Diff state: one entry per seen message id holding its read_at, so
      // each poll emits only new messages and newly-read rows. The diff
      // logic lives in src/chat.ts (chatTailDiff), unit-tested there.
      const state = new Map<number, string | null>();

      // Follow mode holds the handle open until Ctrl-C; the finally below
      // closes it on every exit path, including the SIGINT handler's.
      try {
        // First pass: print the backlog (every existing row as its sent
        // line), then follow unless --once.
        for (const event of chatTailDiff(state, db.chatMessageFeed()).events) {
          if (event.kind === "sent") console.log(formatChatTailEvent(event));
        }
        if (onceOnly) break;

        process.on("SIGINT", () => process.exit(0));
        for (;;) {
          await Bun.sleep(2000);
          try {
            for (const event of chatTailDiff(state, db.chatMessageFeed()).events) {
              console.log(formatChatTailEvent(event));
            }
          } catch (err) {
            // The surface's whole job is watching a shared, mutable file;
            // a feed failure should say so, not die with a stack trace.
            console.error(`[thatch chat tail] feed query failed: ${err}`);
            console.error("The database may be locked or missing; exiting.");
            return;
          }
        }
      } finally {
        db.close();
        // The script tail also closes; closing twice is harmless and the
        // early-return paths need this one.
      }
      break;
    }

    default:
      usage();
  }
}

switch (command) {
  case "--version":
  case "-v":
    console.log(pkg.version);
    process.exit(0);

  case "stores":
    console.log(db.listStores().join("\n"));
    break;

  case "list": {
    const store = args[0] ?? await defaultStore();
    const entries = db.listEntries(store);
    if (entries.length === 0) {
      console.log(`No memories in "${store}".`);
    } else {
      for (const e of entries) {
        const parts = [`[${store}]`, e.label];
        if (e.branch) parts.push(`(branch:${e.branch})`);
        if (e.confidence) parts.push(`(c:${e.confidence})`);
        parts.push(`(${e.updated_at})`);
        console.log(parts.join(" "));
      }
    }
    break;
  }

  case "show": {
    if (!args[0]) usage();
    const label = args[0];
    const store = args[1] ?? await defaultStore();
    const entry = db.showEntry(store, label);
    if (!entry) {
      console.log(`No memory labeled "${label}" in "${store}".`);
    } else {
      console.log(`[${store}] ${entry.label}`);
      if (entry.branch) console.log(`branch: ${entry.branch}`);
      if (entry.confidence) console.log(`confidence: ${entry.confidence}`);
      console.log(`created: ${entry.created_at}  updated: ${entry.updated_at}`);
      console.log();
      // Strip the "# Label\n\n" heading that remember() prepends.
      const body = entry.content.replace(/^# .+\n\n/, "");
      console.log(body);
    }
    break;
  }

  case "forget": {
    if (!args[0]) usage();
    const label = args[0];
    const store = args[1] ?? await defaultStore();
    const ok = db.forgetEntry(store, label);
    console.log(ok ? `[forgotten] ${store} :: ${label}` : `No memory labeled "${label}" in "${store}".`);
    break;
  }

  case "search": {
    if (!args[0]) usage();
    if (args.length > 2) {
      console.error(`error: too many arguments - quote multi-word queries: thatch search "${args.join(" ")}"`);
      process.exit(1);
    }
    const query = args[0];
    const store = args[1] ?? await defaultStore();
    if (args[1] && store !== "all" && !db.listStores().includes(store)) {
      console.error(`error: no store named "${store}" (did you mean to quote the query?)`);
      console.error(`stores: ${db.listStores().join(", ")}`);
      process.exit(1);
    }
    const stores = store === "all" ? [await defaultStore(), "global"] : [store];

    console.error("Loading embedding model...");
    const model = new BgeEmbeddingModel();
    const queryEmb = await model.queryEmbed(query);
    const results = db.recall(stores, queryEmb, { limit: 10 });

    if (results.length === 0) {
      console.log(`No matches for "${query}" in [${stores.join(", ")}].`);
    } else {
      for (const r of results) {
        const score = r._score.toFixed(3);
        const branch = r.branch ? ` branch:${r.branch}` : "";
        const conf = r.confidence ? ` c:${r.confidence}` : "";
        console.log(`[score:${score}] [${r.store}${branch}${conf}] ${r.label}`);
      }
    }
    break;
  }

  case "mcp": {
    // The MCP server manages its own DB connection; close this one first.
    db.close();
    const { runMcpServer } = await import("../src/mcp");
    await runMcpServer();
    // runMcpServer blocks until stdin closes; don't fall through to db.close().
    process.exit(0);
  }

  case "reminder": {
    const isJson = args.includes("--json");
    const repo = await defaultStore();
    const worktree = projectDir();
    let hygiene: string | null = null;
    try {
      hygiene = await hygieneReport(db, repo, worktree);
    } catch (err) {
      console.error(`[thatch] hygiene report failed: ${err}`);
    }
    const reminder = claudeSessionStartReminder(repo, hygiene);
    if (isJson) {
      console.log(JSON.stringify({ additional_context: reminder }));
    } else {
      console.log(reminder);
    }
    break;
  }

  case "hygiene": {
    const repo = await defaultStore();
    const worktree = projectDir();
    const hygiene = await hygieneReport(db, repo, worktree);
    console.log(hygiene ?? "Store is healthy.");
    break;
  }

  case "prime": {
    const primerPrompt = "Load the thatch-project-primer skill and follow its instructions to prime this project's memory store.";
    const opencodeBin = Bun.which("opencode");
    const agentBin = Bun.which("agent");
    const claudeBin = Bun.which("claude");

    if (opencodeBin) {
      console.error("Priming project memory via opencode...");
      const proc = Bun.spawnSync([opencodeBin, "run", primerPrompt], {
        stdout: "inherit",
        stderr: "inherit",
      });
      process.exit(proc.exitCode ?? 1);
    } else if (agentBin) {
      // Cursor CLI: -p for non-interactive print mode, --approve-mcps to
      // auto-approve the thatch MCP server (no interactive UI in -p mode).
      console.error("Priming project memory via cursor agent...");
      const proc = Bun.spawnSync([agentBin, "-p", primerPrompt, "--approve-mcps"], {
        stdout: "inherit",
        stderr: "inherit",
      });
      process.exit(proc.exitCode ?? 1);
    } else if (claudeBin) {
      console.error("Priming project memory via claude...");
      const proc = Bun.spawnSync([claudeBin, primerPrompt], {
        stdout: "inherit",
        stderr: "inherit",
      });
      process.exit(proc.exitCode ?? 1);
    } else {
      console.error("Error: none of 'opencode', 'agent', or 'claude' found on PATH.");
      console.error("Install one of them to use thatch prime.");
      process.exit(1);
    }
    break;
  }

  case "setup": {
    const isGlobal = args.includes("--global");
    // --local is the default scope; accepted explicitly so the flag the
    // user types always matches what the command does.
    const isLocal = args.includes("--local");
    const isClaude = args.includes("--claude");
    const isCursor = args.includes("--cursor");

    if (isGlobal && isLocal) {
      console.error("Choose one scope: --local or --global.");
      process.exit(1);
    }
    if (!isClaude && !isCursor) {
      console.error("Specify at least one host: --claude and/or --cursor.");
      console.error("Usage: thatch setup --claude [--cursor] [--local|--global]");
      process.exit(1);
    }

    // Resolve the thatch binary path for hooks and MCP config.
    // If `thatch` is on PATH (npm global install, opencode plugin install),
    // use the bare name - it survives updates and works across machines.
    // If not on PATH (local dev checkout), use the absolute path to this script.
    const thatchOnPath = Bun.which("thatch");
    const thatchBin = thatchOnPath ?? resolve(process.argv[1] ?? process.execPath);
    const dir = projectDir();

    // Shared reporting: where skills went and what the pass did, so an
    // idempotent re-run still tells the user something true.
    const printSkills = (result: { skills: { dir: string; added: unknown[]; updated: unknown[]; removed: string[]; unchanged: string[] }; otherScopeSkills: { dir: string; count: number } | null; global: boolean }) => {
      const { added, updated, removed, unchanged } = result.skills;
      console.log(`  Skills:        ${result.skills.dir}`);
      console.log(`                 ${added.length} added, ${updated.length} updated, ${removed.length} removed, ${unchanged.length} unchanged`);
      if (result.otherScopeSkills) {
        const { dir: otherDir, count } = result.otherScopeSkills;
        if (result.global) {
          console.log(`  Note: ${count} thatch skills exist in ${otherDir} (project scope); --global does not update them.`);
        } else {
          console.log(`  Note: ${count} thatch skills remain in ${otherDir} (user scope; not updated by this run). Run setup with --global to refresh them, or remove them if this repo now owns its skills.`);
        }
      }
    };

    if (isClaude) {
      const result = setupClaudeCode(thatchBin, isGlobal, dir);

      console.log(`Thatch setup complete for Claude Code (${isGlobal ? "global" : "project-local"}).`);
      console.log();
      if (result.mcpConfig) {
        console.log(`  MCP config:    ${result.mcpConfig}`);
      }
      console.log(`  Instructions:  ${result.claudeMd}`);
      console.log(`  Hooks:         ${result.settings}`);
      printSkills(result);
      console.log();
      if (result.mcpAddCommand) {
        console.log("To register the MCP server globally, run:");
        console.log(`  ${result.mcpAddCommand}`);
        console.log();
      }
      console.log("Restart Claude Code for the changes to take effect.");
    }

    if (isCursor) {
      const result = setupCursor(thatchBin, isGlobal, dir);

      console.log();
      console.log(`Thatch setup complete for Cursor (${isGlobal ? "global" : "project-local"}).`);
      console.log();
      console.log(`  MCP config:    ${result.mcpConfig}`);
      console.log(`  Instructions:  ${result.agentsMd}`);
      console.log(`  Hooks:         ${result.hooks}`);
      printSkills(result);
      console.log();
      console.log("Restart Cursor for the changes to take effect.");
    }
    break;
  }

  case "session": {
    await sessionCommand(args);
    break;
  }

  case "chat": {
    await chatCommand(args);
    break;
  }

  case "buffer-batch": {
    // PostToolBatch hook: append the batch's tool_calls to the session's
    // JSONL queue. Silent on success - no stdout - so the next model call
    // is not delayed waiting for an exit code-driven message.
    try {
      const raw = await Bun.stdin.text();
      const data = JSON.parse(raw) as { session_id?: string; tool_calls?: unknown[] };
      if (data.session_id && Array.isArray(data.tool_calls)) {
        const { appendBatch } = await import("../src/extract-queue");
        appendBatch(data.session_id, data.tool_calls as never);
      }
    } catch (err) {
      console.error(`[thatch buffer-batch] failed: ${err}`);
    }
    break;
  }

  case "buffer-tool": {
    // Cursor postToolUse hook: append a single tool interaction to the
    // session's JSONL queue. Cursor fires postToolUse per-tool (no batch
    // equivalent), so this receives one tool at a time. Silent on success.
    // Session ID comes as `conversation_id` in Cursor (vs `session_id` in
    // Claude Code). The tool result field name is not explicitly documented,
    // so we try the most likely candidates.
    try {
      const raw = await Bun.stdin.text();
      const data = JSON.parse(raw) as {
        conversation_id?: string;
        session_id?: string;
        tool_name?: string;
        tool_input?: Record<string, unknown>;
        tool_use_id?: string;
        tool_result?: string | unknown[];
        tool_response?: string | unknown[];
        result_json?: string;
        result?: string | unknown[];
        output?: string;
      };
      const sessionID = data.conversation_id ?? data.session_id;
      if (sessionID && data.tool_name) {
        const { appendBatch } = await import("../src/extract-queue");
        const response = data.tool_result ?? data.tool_response ?? data.result_json ?? data.result ?? data.output ?? "";
        appendBatch(sessionID, [{
          tool_name: data.tool_name,
          tool_input: data.tool_input ?? {},
          tool_use_id: data.tool_use_id,
          tool_response: response,
        }]);
      }
    } catch (err) {
      console.error(`[thatch buffer-tool] failed: ${err}`);
    }
    break;
  }

  case "flush-tools": {
    // UserPromptSubmit (Claude Code) / beforeSubmitPrompt (Cursor) hook.
    // Three priority tiers:
    //   1. Extraction nudge - buffered tool interactions are queued for fact
    //      extraction (carries the JSON payload for thatch-fact-extractor).
    //   2. Recall nudge - the user's prompt semantically matches existing
    //      memories. Uses the sideband socket to ask the warm MCP server to
    //      embed the prompt and search, avoiding a cold model load here.
    //   3. Write nudge - static "did you learn anything?" fallback for
    //      conversational turns with no tool use and no memory matches.
    // --json wraps output as { additional_context: "..." } for Cursor hooks.
    // Without --json, stdout is plain text (Claude Code style).
    const isJson = args.includes("--json");
    try {
      const raw = await Bun.stdin.text();
      const data = JSON.parse(raw) as {
        session_id?: string;
        conversation_id?: string;
        prompt?: string;
        message?: string;
        text?: string;
        user_input?: string;
        input?: string;
      };
      const sessionID = data.session_id ?? data.conversation_id;

      const { peekQueue, getMissedCount, incrementMissedCount } = await import("../src/extract-queue");
      const { extractionNudge, claudeWriteNudge, claudeRecallNudge, predictionNudge, behaviorNudge } = await import("../src/prompts");
      const { detectSkew, readNpmCacheForUpdate } = await import("../src/version-check");

      let repo = "unknown";
      try { repo = await detectRepo(); } catch {}

      // Version checks (best-effort, no network, instant):
      //   - Skew: the running MCP server's version file differs from this
      //     binary's version. Means the user upgraded but didn't restart.
      //   - Update: the npm cache file (written by the MCP server's
      //     background poll) says a newer version is published.
      // The warning is prepended to whatever nudge the tiers below produce.
      // This is the primary delivery channel for version warnings because
      // flush-tools fires on every prompt, including conversational turns
      // with no tool calls.
      const versionWarning = detectSkew(dbPath) ?? readNpmCacheForUpdate(dbPath);

      // Tier 1: extraction nudge. Peek (don't drain) - the queue persists
      // until the agent calls memory_remember, which triggers consumeQueue.
      // If the agent ignores the nudge, the payload grows on the next flush.
      // The nudge carries the session ID, not the full payload — the
      // sub-agent fetches it via get_extraction_payload.
      const interactions = sessionID ? peekQueue(sessionID) : [];
      if (interactions.length > 0) {
        const missed = sessionID ? getMissedCount(sessionID) : 0;
        if (sessionID) incrementMissedCount(sessionID);
        const output = extractionNudge(interactions.length, missed, "mcp__thatch__memory_remember", sessionID ?? "");
        emit(output, versionWarning, isJson);
        break;
      }

      // Tier 2: recall nudge + prediction fire via sideband. The prompt text
      // field name varies by host (Claude Code: "prompt", Cursor: undocumented).
      // Both recall and predictions share the same sideband round-trip.
      const promptText = data.prompt ?? data.message ?? data.text ?? data.user_input ?? data.input;
      if (promptText && promptText.length >= 10) {
        const { sidebandMatch, sidebandPredictions, sidebandBehaviors, sidebandSocketPath } = await import("../src/sideband");
        const sockPath = sidebandSocketPath(dbPath);
        const recallThreshold = parseFloat(process.env.THATCH_RECALL_THRESHOLD ?? "0.55");
        const predThreshold = parseFloat(process.env.THATCH_PREDICTION_THRESHOLD ?? "0.60");
        const behaviorThreshold = parseFloat(process.env.THATCH_BEHAVIOR_THRESHOLD ?? "0.60");

        const [matches, predictions, behaviors] = await Promise.all([
          sidebandMatch(sockPath, promptText, [repo, "global"], recallThreshold, 5),
          sidebandPredictions(sockPath, promptText, [repo, "global"], predThreshold, 5),
          sidebandBehaviors(sockPath, promptText, [repo, "global"], behaviorThreshold, 5),
        ]);

        const parts: string[] = [];
        if (matches && matches.length > 0) {
          parts.push(claudeRecallNudge(matches));
        }
        if (predictions && predictions.length > 0) {
          parts.push(predictionNudge(predictions));
        }
        if (behaviors && behaviors.length > 0) {
          parts.push(behaviorNudge(behaviors));
        }

        if (parts.length > 0) {
          const output = parts.join("\n\n");
          emit(output, versionWarning, isJson);
          break;
        }
      }

      // Tier 3: static write nudge.
      const output = claudeWriteNudge();
      emit(output, versionWarning, isJson);
    } catch (err) {
      console.error(`[thatch flush-tools] failed: ${err}`);
      try {
        const { claudeWriteNudge } = await import("../src/prompts");
        const fallback = claudeWriteNudge();
        if (isJson) {
          console.log(JSON.stringify({ additional_context: fallback }));
        } else {
          console.log(fallback);
        }
      } catch {
        // If even the fallback import fails, do nothing - silent failure is
        // preferable to blocking the user's prompt over an unrelated hook.
      }
    }
    break;
  }

  case "flush-predictions": {
    // UserPromptSubmit (Claude Code) / beforeSubmitPrompt (Cursor) hook.
    // Standalone prediction fire: queries the sideband for scored
    // predictions matching the prompt text, prints the prediction nudge
    // if any matchers fire. --json wraps as { additional_context: "..." }
    // for Cursor hooks. Without --json, stdout is plain text.
    //
    // NOTE: flush-tools already fires predictions alongside the recall
    // nudge in its tier 2 block. This subcommand exists for testing and
    // for hosts that want prediction-only output without the recall or
    // extraction nudges.
    const isJson = args.includes("--json");
    try {
      const raw = await Bun.stdin.text();
      const data = JSON.parse(raw) as {
        prompt?: string;
        message?: string;
        text?: string;
        user_input?: string;
        input?: string;
      };

      const promptText = data.prompt ?? data.message ?? data.text ?? data.user_input ?? data.input;
      if (!promptText || promptText.length < 10) {
        if (isJson) console.log(JSON.stringify({ additional_context: "" }));
        break;
      }

      let repo = "unknown";
      try { repo = await detectRepo(); } catch {}

      const { sidebandPredictions, sidebandSocketPath } = await import("../src/sideband");
      const { predictionNudge } = await import("../src/prompts");
      const sockPath = sidebandSocketPath(dbPath);
      const threshold = parseFloat(process.env.THATCH_PREDICTION_THRESHOLD ?? "0.60");
      const predictions = await sidebandPredictions(sockPath, promptText, [repo, "global"], threshold, 5);

      if (predictions && predictions.length > 0) {
        const output = predictionNudge(predictions);
        if (isJson) console.log(JSON.stringify({ additional_context: output }));
        else console.log(output);
      } else {
        if (isJson) console.log(JSON.stringify({ additional_context: "" }));
      }
    } catch (err) {
      console.error(`[thatch flush-predictions] failed: ${err}`);
    }
    break;
  }

  default:
    usage();
}

db.close();
