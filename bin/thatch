#!/usr/bin/env bun

import { homedir } from "node:os";
import { join, resolve } from "node:path";
import pkg from "../package.json" with { type: "json" };
import { ThatchDB } from "../src/db";
import { detectRepo } from "../src/git";
import { BgeEmbeddingModel } from "../src/embeddings";
import { hygieneReport } from "../src/hygiene";
import { claudeSessionStartReminder } from "../src/prompts";
import { setupClaudeCode, setupCursor, registerClaudeMcpServer } from "../src/setup";
import { resolveOpencodeDbPath, SessionDB, partToTimelineEntry, partToTranscriptEntries, partToFullJson, messageToFullJson, type SessionPart } from "../src/session-db";
import { chatTailDiff, chatTailBacklog, filterChatTailRows, formatChatTailJsonl, CHAT_TAIL_DEFAULT_LIMIT, parseChatTimeBound, CHAT_STALE_MS, CHAT_RENUDGE_MINUTES, chatLiveness, humanAge, splitChatRoster, sortChatRoster, mcpSessionID, isoMinutesAgo, renderChatParticipant, resolveRegisteredPredecessor, type ChatSessionRow, type ChatTailFilter } from "../src/chat";
import { chatEnabled, loadConfig } from "../src/config";
import { chatNotificationNudge } from "../src/prompts";
