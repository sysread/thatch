const configHome = process.env.XDG_CONFIG_HOME ?? join(homedir(), ".config");
const dbPath = process.env.THATCH_DB_PATH ?? join(configHome, "thatch", "thatch.db");
const db = new ThatchDB(dbPath);

const [command, ...args] = process.argv.slice(2);

function usage(): never {
  console.error(`USAGE
  thatch --version, -v             Print version and exit
  thatch stores                    List all stores
  thatch list   [store]            List memory labels in a store  
  thatch show   <label> [store]    Display a memory by label
  thatch forget <label> [store]    Remove a memory by label
  thatch search <query> [store]    Semantic search (cosine similarity)
  thatch mcp                       Start the stdio MCP server (for Claude Code, Cursor, etc.)
  thatch reminder [--json]         Print session-start reminder (for SessionStart hook)
  thatch hygiene                   Print the hygiene report (standalone)
  thatch prime                     Prime project memory (runs the primer skill via opencode, cursor, or claude)
  thatch buffer-batch              Append a PostToolBatch payload to the queue (Claude Code hook only)
  thatch buffer-tool               Append a single postToolUse interaction to the queue (Cursor hook only)
  thatch flush-tools [--json]      Peek the queue + print an extraction nudge (hook only)
  thatch chat-notify               Print a chat follow-up message when mail is unread (Cursor stop hook)
  thatch flush-predictions [--json] Query predictions for the prompt (hook only)
  thatch setup --claude [--cursor] [--local|--global]
                                   Install config + instructions + hooks + skills
  thatch session list -s <id> [--after T] [--before T]
                                   JSONL timeline of a session's parts (one line per part)
  thatch session get --id <part_id|msg_id>
                                   Full JSON of one part (tool parts include their output)
                                   or one message with all its parts
  thatch session transcript -s <id>
                                   Full conversation as OpenAI chat-completions JSONL
  thatch session search <query> [--session <id>] [--regex] [--limit N]
                                   JSONL of matching parts across sessions (decoded content)
  thatch chat list [--stale N|all]  Registered chat sessions, grouped Active/Stale:
                                    name, age, status, project, topic.
                                    --stale N (days) hides stale sessions
                                    older than N; default 1. --stale all
                                    shows every stale session.
  thatch chat tail [--once] [--limit N|all] [--match RE]
                   [--from NAME] [--to NAME] [--since DT] [--until DT]
                                   Follow cross-session chat as a JSONL
                                   event log: one line per event, "sent"
                                   and "read" as separate events linked by
                                   message id. The backlog shows the last
                                   ${CHAT_TAIL_DEFAULT_LIMIT} messages
                                   (--limit N or --limit all to override).
                                   --match filters message bodies
                                   (repeatable, ANDed); --from/--to filter
                                   participant names; --since/--until bound
                                   the window ("YYYY-MM-DD [HH:MM]" local
                                   time). Filters apply to follow mode too.

Stores default to the repo detected from git remote. Use "global" for the
global store. Use "all" with search to search project + global together.`);
  process.exit(1);
}

async function defaultStore(): Promise<string> {
  try {
    return await detectRepo();
  } catch {
    return "unknown";
  }
}

/**
 * Builds the chat-mail hook line for the given project. With a hook
 * session ID (Claude Code/Cursor pass one in the hook's stdin JSON), it
 * first ensures the caller is registered - the host's assigned identity -
 * and prints that identity plus the caller's own unread count, so the
 * model learns who it is on every prompt without a tool call. Without a
 * session ID it keeps the old shape: a line only when pending mail exists
 * for registered sessions in the project, naming the addressees.
 */
async function chatHookLine(hookSessionID?: string, transcriptPath?: string): Promise<string> {
  // Disabled chat prints nothing: the hook line must not advertise a
  // feature the user turned off (the tools refuse, the poller never
  // starts, the prompt section omits chat).
  if (!chatEnabled(loadConfig(dbPath).config)) return "";
  let repo: string | null = null;
  try {
    repo = await detectRepo();
  } catch {
    return "";
  }

  if (hookSessionID) {
    // Ensure-register: idempotent, so every prompt re-touches liveness and
    // the first prompt of a conversation mints the assigned name. This is
    // the MCP identity anchor - the session ID is stable per conversation,
    // so re-registering finds the same row and name.
    const sessionID = mcpSessionID(hookSessionID);
    // Continuation adoption: Claude Code forks the session id on resume
    // (and has been observed to fork spontaneously), stranding the old
    // identity and mailbox. When this session is unknown, look for a
    // predecessor transcript handing off to it; adopting keeps the name
    // and mail following the human-level conversation. Runs before the
    // ensure so the migrated row is the one re-registered.
    if (!db.findChatSession(sessionID) && transcriptPath) {
      try {
        const pred = resolveRegisteredPredecessor(transcriptPath, hookSessionID, (raw) =>
          db.findChatSession(mcpSessionID(raw))?.session_id ?? null,
        );
        if (pred) {
          db.continueChatSession(pred, sessionID);
          hookDebug("hook:adoption", `continued chat identity: ${pred} -> ${sessionID}`);
        }
      } catch (err) {
        console.error(`[thatch] chat continuation adoption failed: ${err}`);
      }
    }
    // The leave tombstone blocks this ensure: chat_unregister must outlive
    // the turn that issued it, on MCP hosts as on opencode. The line is
    // the standing signal - it repeats every prompt until the model
    // rejoins, and it says plainly that rejoining mints a fresh identity,
    // because the old one is closed for good (assigned names are never
    // reused, so a tombstoned identity cannot be resurrected by a later
    // register).
    if (db.hasChatLeaveTombstone(sessionID) && !db.chatLeaveSuperseded(sessionID, repo)) {
      return `[thatch] chat: this conversation left the chat directory (chat_unregister) and will not receive mail. If the user asks to rejoin, call thatch_chat_register with no arguments - that mints a fresh identity; the old one stays closed.`;
    }
    db.registerChatSession(sessionID, repo, null, "mcp");
    const me = db.findChatSession(sessionID);
    if (!me) return "";
    const mine = db.unreadChatCount(sessionID);
    const pendingOthers = db
      .chatPendingByProject(repo)
      .filter((p) => p.name !== me.name);
    const others = pendingOthers.length > 0
      ? ` Others in this project with unread mail: ${pendingOthers.map((p) => `${p.name} (${p.pending})`).join(", ")}.`
      : "";
    const mailbox = mine > 0 ? `${mine} unread message(s) for you` : "no unread mail for you";
    return `[thatch] chat: you are ${me.name} (${mailbox}).${others}`;
  }

  const pending = db.chatPendingByProject(repo);
  if (pending.length === 0) return "";
  const parts = pending.map((p) => `${p.name} (${p.pending})`);
  return `[thatch] chat: unread message(s) for ${parts.join(", ")} - the addressee should call chat_read`;
}

/**
 * Reads the hook session ID from stdin without hanging when no payload is
 * coming. Interactive runs skip the read outright (isTTY); a piped or
 * inherited stdin that never closes (bare spawns) gives up after a short
 * grace period. Hook hosts write the payload immediately at spawn, so the
 * grace window costs nothing on the hot path. Malformed payloads resolve to
 * undefined rather than failing the reminder.
 */
/**
 * Reads the hook's stdin JSON without hanging when no payload is coming.
 * Interactive runs skip the read outright (isTTY); a piped or inherited
 * stdin that never closes (bare spawns) gives up after a short grace
 * period and destroys the stream, because a pending stdin read keeps
 * the process alive after main finishes. Hook hosts write the payload
 * immediately at spawn, so the grace window costs nothing on the hot path.
 * Malformed payloads resolve to undefined rather than failing the command.
 * Uses the Node stream API instead of Bun.stdin.text(): a pending
 * Bun.stdin read cannot be cancelled and pins the process forever.
 */
function readHookInput(tag: string): Promise<Record<string, unknown> | undefined> {
  if (process.stdin.isTTY) return Promise.resolve(undefined);
  return new Promise((resolve) => {
    const chunks: Buffer[] = [];
    const timer = setTimeout(() => done(undefined), 500);
    const done = (value: string | undefined) => {
      clearTimeout(timer);
      process.stdin.destroy();
      try {
        if (!value) return resolve(undefined);
        logHookPayload(tag, value);
        resolve(JSON.parse(value) as Record<string, unknown>);
      } catch {
        resolve(undefined);
      }
    };
    process.stdin.on("data", (chunk: Buffer) => chunks.push(chunk));
    process.stdin.on("end", () => done(Buffer.concat(chunks).toString()));
    process.stdin.on("error", () => done(undefined));
  });
}

const hookDebug = createDebugLog(dbPath);

/**
 * Debug-logs one hook invocation's raw stdin payload (tag hook:<command>,
 * payload truncated). Answers "did the host fire the hook at all, and what
 * did it send?" - the chat DB cannot distinguish a hook that never fired
 * from one whose payload carried no session id, and host hook contracts
 * are sometimes documented wrong.
 */
function logHookPayload(command: string, raw: string): void {
  const clipped = raw.length > 2000 ? `${raw.slice(0, 2000)}...` : raw;
  hookDebug(`hook:${command}`, `stdin: ${JSON.stringify(clipped)}`);
}

/**
 * Emits the nudge output, prepending a version warning if present. The
 * warning goes first so the LLM sees it before the nudge text. Used by
 * flush-tools to surface version skew and update-available notices on
 * every UserPromptSubmit, regardless of which tier fired. The chat hook
 * line, when present, is appended last (the identity/mail check is the
 * last thing the model reads before the nudge body).
 */
function emit(output: string, versionWarning: string | null, isJson: boolean, chatLine = ""): void {
  if (chatLine) {
    output = `${output}\n\n${chatLine}`;
  }
  if (versionWarning) {
    output = `[thatch] ${versionWarning}\n\n${output}`;
  }
  if (isJson) console.log(JSON.stringify({ additional_context: output }));
  else console.log(output);
}

/** Resolve the project directory from host-specific env vars or cwd. */
function projectDir(): string {
  return process.env.CURSOR_PROJECT_DIR ?? process.env.CLAUDE_PROJECT_DIR ?? process.cwd();
}

// ---------------------------------------------------------------------------
// session subcommand group - read-only archaeology on the opencode db
// ---------------------------------------------------------------------------

/** Parses an ISO timestamp or epoch-milliseconds value into epoch ms. */
function parseTimeBound(value: string, flag: string): number {
  const asNum = Number(value);
  if (Number.isFinite(asNum) && value !== "") return asNum;
  const parsed = Date.parse(value);
  if (Number.isNaN(parsed)) {
    console.error(`error: ${flag} expects an ISO timestamp or epoch ms, got "${value}"`);
    process.exit(1);
  }
  return parsed;
}

/** Reads a flag's value (-flag value or --flag=value forms). A flag given
 *  with no value is a typo, not a default - it dies loudly so `--until`
 *  at the end of a command line cannot silently disable the bound. */
function flagValue(flags: string[], ...names: string[]): string | undefined {
  for (let i = 0; i < flags.length; i++) {
    for (const name of names) {
      if (flags[i] === name) {
        if (flags[i + 1] === undefined) {
          console.error(`error: ${name} expects a value`);
          process.exit(1);
        }
        return flags[i + 1];
      }
      if (flags[i]?.startsWith(`${name}=`)) return flags[i]!.slice(name.length + 1);
    }
  }
  return undefined;
}

/** Collects every occurrence of a repeatable flag, dying on a dangling one. */
function flagValues(flags: string[], ...names: string[]): string[] {
  const out: string[] = [];
  for (let i = 0; i < flags.length; i++) {
    for (const name of names) {
      if (flags[i] === name) {
        if (flags[i + 1] === undefined) {
          console.error(`error: ${name} expects a value`);
          process.exit(1);
        }
        out.push(flags[i + 1]);
      } else if (flags[i]?.startsWith(`${name}=`)) out.push(flags[i]!.slice(name.length + 1));
    }
  }
  return out;
}

function openSessionDb(): SessionDB {
  const path = resolveOpencodeDbPath();
  if (!path) {
    console.error(
      "error: no opencode database found. The session commands inspect the\n" +
        "session history of the opencode host; other hosts (Claude Code, Cursor)\n" +
        "have no such database. Set OPENCODE_DB to point at an opencode.db file.",
    );
    process.exit(1);
  }
  return new SessionDB(path);
}

async function sessionCommand(rest: string[]): Promise<void> {
  const [sub, ...restArgs] = rest;
  const sessionID = flagValue(restArgs, "-s", "--session");
  const after = flagValue(restArgs, "--after");
  const before = flagValue(restArgs, "--before");

  const db = openSessionDb();
  try {
    switch (sub) {
      case "list": {
        if (!sessionID) {
          console.error("error: session list requires -s/--session <session id>");
          process.exit(1);
        }
        const parts = db.listParts(
          sessionID,
          after ? parseTimeBound(after, "--after") : undefined,
          before ? parseTimeBound(before, "--before") : undefined,
        );
        for (const part of parts) console.log(JSON.stringify(partToTimelineEntry(part)));
        break;
      }

      case "get": {
        const id = flagValue(restArgs, "--id");
        if (!id) {
          console.error("error: session get requires --id <part_id|msg_id>");
          process.exit(1);
        }
        if (id.startsWith("msg_")) {
          const message = db.getMessage(id);
          if (!message) {
            console.error(`error: no message "${id}" in ${db.path}`);
            process.exit(1);
          }
          console.log(JSON.stringify(messageToFullJson(message), null, 2));
        } else {
          const part = db.getPart(id);
          if (!part) {
            console.error(`error: no part "${id}" in ${db.path}`);
            process.exit(1);
          }
          console.log(JSON.stringify(partToFullJson(part), null, 2));
        }
        break;
      }

      case "transcript": {
        if (!sessionID) {
          console.error("error: session transcript requires -s/--session <session id>");
          process.exit(1);
        }
        for (const message of db.listMessages(sessionID)) {
          for (const entry of partToTranscriptEntries(message.role, message.parts)) {
            console.log(JSON.stringify(entry));
          }
        }
        break;
      }

      case "search": {
        // Positional = args not preceded by a value-taking flag. Values like
        // "50" or a session id don't start with "-", so predecessor checks
        // are the only reliable discriminator.
        const valueFlags = new Set(["-s", "--session", "--limit"]);
        const positional = restArgs.filter((a, i) => !a.startsWith("-") && !valueFlags.has(restArgs[i - 1] ?? ""));
        const query = positional[0];
        if (!query) {
          console.error("error: session search requires a query (substring, or regex with --regex)");
          process.exit(1);
        }
        const limit = flagValue(restArgs, "--limit");
        const matches = db.search(query, {
          regex: restArgs.includes("--regex"),
          sessionID,
          limit: limit ? parseInt(limit, 10) : undefined,
        });
        // Titles let a cross-session result list be triaged without a
        // second lookup per hit. Sessions are cached - matches cluster.
        const titles = new Map<string, string | null>();
        for (const part of matches) {
          if (!titles.has(part.sessionId)) {
            titles.set(part.sessionId, db.getSession(part.sessionId)?.title ?? null);
          }
          const entry: Record<string, unknown> = {
            session_id: part.sessionId,
            session_title: titles.get(part.sessionId),
            ...partToTimelineEntry(part),
          };
          console.log(JSON.stringify(entry));
        }
        break;
      }

      default:
        usage();
    }
  } finally {
    db.close();
  }
}

// ---------------------------------------------------------------------------
// chat subcommand group - read-only window on the cross-session chat
// ---------------------------------------------------------------------------

/** Column headers for the `chat list` roster, in display order. */
const CHAT_ROSTER_HEADER = ["NAME", "AGE", "STATUS", "PROJECT", "TOPIC"];

/**
 * Renders the `chat list` roster as two sections - Active and Stale - each
 * an aligned-column table under a header row. Section headers are bold,
 * the stale explainer is muted italic; rows use green names, dim age,
 * green/red status, and a muted italic topic.
 * staleCapMs bounds how old a stale row is displayed (null = no bound);
 * rows past the cap collapse into a muted hidden-count note so the reader
 * knows rows exist that the window left out.
 * Color is applied only when stdout is an interactive terminal (and
 * NO_COLOR is unset), so piped output - grep, redirect, QA runners - stays
 * clean plain text.
 */
function formatChatRoster(sessions: ChatSessionRow[], staleCapMs: number | null = null): string {
  const colored = process.stdout.isTTY === true && !process.env.NO_COLOR;
  const paint = (code: string, s: string) => (colored ? `\x1b[${code}m${s}\x1b[0m` : s);
  const { active, stale, staleHidden } = splitChatRoster(sortChatRoster(sessions), Date.now(), staleCapMs);
  const renderTable = (rows: ChatSessionRow[]) => {
    const cells = (r: ChatSessionRow) => [
      r.name,
      humanAge(r.last_seen),
      chatLiveness(r),
      r.project ?? "unknown",
      r.topic ?? "",
    ];
    // Widths come from the PLAIN cell text; color is applied after padding
    // so zero-width escape codes never skew the alignment.
    const widths = CHAT_ROSTER_HEADER.map((h, i) => Math.max(h.length, ...rows.map((r) => cells(r)[i].length)));
    const align = (line: string[]) => line.map((c, i) => (i < line.length - 1 ? c.padEnd(widths[i]) : c));
    const header = align(CHAT_ROSTER_HEADER).map((h) => paint("1", h)).join("  ");
    const body = rows.map((r) => {
      const [name, age, status, project, topic] = align(cells(r));
      return [
        paint("32", name),
        paint("2", age),
        paint(status === "stale" ? "31" : "32", status),
        project,
        topic ? paint("3;90", topic) : "",
      ].join("  ").trimEnd();
    });
    return [header, ...body].join("\n");
  };
  const parts: string[] = [];
  if (active.length > 0) {
    parts.push([paint("1", "# Active Sessions"), renderTable(active)].join("\n"));
  }
  if (stale.length > 0 || staleHidden > 0) {
    const lines = [paint("1", "# Stale Sessions")];
    if (stale.length > 0) {
      const explainer = `These sessions have missed their heartbeat for over ${Math.round(CHAT_STALE_MS / 1000)} seconds. Their harnesses may no longer be running (stopped, or the machine slept); mail waits until they resume.`;
      lines.push(paint("3;90", explainer), renderTable(stale));
    }
    if (staleHidden > 0) {
      lines.push(
        paint(
          "3;90",
          `${staleHidden} older stale session${staleHidden === 1 ? "" : "s"} hidden; --stale N widens the window to N days, --stale all shows everything.`,
        ),
      );
    }
    parts.push(lines.join("\n"));
  }
  return parts.join("\n\n");
}

async function chatCommand(rest: string[]): Promise<void> {
  const [sub, ...restArgs] = rest;

  switch (sub) {
    case "list": {
      // --stale N bounds how old a stale row the roster displays, in days
      // (fractions allowed); the default of one day keeps long-dead
      // sessions from burying the fresh signal. --stale all restores the
      // unbounded view. A bad value dies loudly rather than silently
      // shrinking the roster.
      const staleArg = flagValue(restArgs, "--stale");
      let staleCapMs: number | null = 24 * 60 * 60 * 1000;
      if (staleArg !== undefined) {
        if (staleArg === "all") staleCapMs = null;
        else if (!/^\d+(\.\d+)?$/.test(staleArg) || Number(staleArg) <= 0) {
          console.error(`error: --stale expects a positive number of days or "all", got "${staleArg}"`);
          process.exit(1);
        } else staleCapMs = Number(staleArg) * 24 * 60 * 60 * 1000;
      }
      const sessions = db.listChatSessions();
      if (sessions.length === 0) {
        console.log("No sessions registered. Sessions join the directory automatically on their first idle (opencode), or via chat_register.");
        break;
      }
      console.log(formatChatRoster(sessions, staleCapMs));
      break;
    }

    case "tail": {
      const onceOnly = restArgs.includes("--once");
      // Parse and validate everything up front: a bad regex or date must
      // fail before any lines print, not mid-follow.
      const matches = flagValues(restArgs, "--match").map((pattern) => {
        try {
          return new RegExp(pattern);
        } catch {
          console.error(`error: --match is not a valid regular expression: "${pattern}"`);
          process.exit(1);
        }
      });
      const limitArg = flagValue(restArgs, "--limit");
      let limit: number | null = CHAT_TAIL_DEFAULT_LIMIT;
      if (limitArg !== undefined) {
        if (limitArg === "all") limit = null;
        else if (!/^\d+$/.test(limitArg)) {
          console.error(`error: --limit expects a positive integer or "all", got "${limitArg}"`);
          process.exit(1);
        } else limit = Number(limitArg);
        if (limit !== null && limit < 1) {
          console.error(`error: --limit expects a positive integer or "all", got "${limitArg}"`);
          process.exit(1);
        }
      }
      let sinceMs: number | null = null;
      let untilMs: number | null = null;
      try {
        const since = flagValue(restArgs, "--since");
        const until = flagValue(restArgs, "--until");
        if (since !== undefined) sinceMs = parseChatTimeBound(since, "--since");
        if (until !== undefined) untilMs = parseChatTimeBound(until, "--until");
      } catch (err) {
        console.error(`error: ${(err as Error).message}`);
        process.exit(1);
      }
      if (sinceMs !== null && untilMs !== null && sinceMs >= untilMs) {
        console.error("error: --since is not before --until; the window is empty");
        process.exit(1);
      }
      const fromName = flagValue(restArgs, "--from");
      const toName = flagValue(restArgs, "--to");
      const filter: ChatTailFilter = {
        matches,
        fromSubstr: fromName !== undefined ? [fromName] : [],
        toSubstr: toName !== undefined ? [toName] : [],
        sinceMs,
        untilMs,
      };

      // Diff state: one entry per seen message id holding its read_at, so
      // each poll emits only new messages and newly-read rows. The diff
      // and backlog logic lives in src/chat.ts (chatTailDiff,
      // chatTailBacklog), unit-tested there. The backlog seeds the state
      // from every feed row, so the limit hides lines, not history.
      let state: Map<number, string | null>;

      // Follow mode holds the handle open until Ctrl-C. The finally below
      // closes it on every exit path except the SIGINT handler's, which
      // is why the handler closes it itself: process.exit does not unwind
      // finally blocks (closing twice is harmless).
      try {
        // First pass: print the backlog, then follow unless
        // --once or the --until window has already closed (a closed
        // window has no future events to follow). The backlog fetch gets
        // the same friendly failure treatment as follow polls: a locked
        // or missing database should say so, not die with a stack trace.
        let backlog;
        try {
          backlog = chatTailBacklog(db.chatMessageFeed(), filter, limit);
        } catch (err) {
          console.error(`[thatch chat tail] feed query failed: ${err}`);
          console.error("The database may be locked or missing; exiting.");
          return;
        }
        state = backlog.state;
        if (backlog.elided > 0) {
          // The elision note goes to stderr so stdout stays pure JSONL
          // for pipes.
          console.error(
            `[thatch chat tail] showing last ${backlog.shown} of ${backlog.elided + backlog.shown} messages (--limit N, --limit all)`,
          );
        }
        for (const event of backlog.events) console.log(formatChatTailJsonl(event));
        if (onceOnly || (filter.untilMs !== null && filter.untilMs <= Date.now())) break;

        process.on("SIGINT", () => {
          db.close();
          process.exit(0);
        });
        for (;;) {
          await Bun.sleep(2000);
          try {
            // Follow polls re-filter the live feed: matching messages
            // surface as they arrive, non-matching ones stay invisible.
            for (const event of chatTailDiff(state, filterChatTailRows(db.chatMessageFeed(), filter)).events) {
              console.log(formatChatTailJsonl(event));
            }
          } catch (err) {
            // The surface's whole job is watching a shared, mutable file;
            // a feed failure should say so, not die with a stack trace.
            console.error(`[thatch chat tail] feed query failed: ${err}`);
            console.error("The database may be locked or missing; exiting.");
            return;
          }
          // The window check runs after the poll, so a message created
          // inside the window but landed during the final sleep is still
          // displayed; anything inserted after this poll has a created_at
          // past the bound and is filtered by the window anyway.
          if (filter.untilMs !== null && Date.now() >= filter.untilMs) break;
        }
      } finally {
        db.close();
        // The script tail also closes; closing twice is harmless and the
        // early-return paths need this one.
      }
      break;
    }

    default:
      usage();
  }
}

switch (command) {
  case "--version":
  case "-v":
    console.log(pkg.version);
    process.exit(0);

  case "stores":
    console.log(db.listStores().join("\n"));
    break;

  case "list": {
    const store = args[0] ?? await defaultStore();
    const entries = db.listEntries(store);
    if (entries.length === 0) {
      console.log(`No memories in "${store}".`);
    } else {
      for (const e of entries) {
        const parts = [`[${store}]`, e.label];
        if (e.branch) parts.push(`(branch:${e.branch})`);
        if (e.confidence) parts.push(`(c:${e.confidence})`);
        parts.push(`(${e.updated_at})`);
        console.log(parts.join(" "));
      }
    }
    break;
  }

  case "show": {
    if (!args[0]) usage();
    const label = args[0];
    const store = args[1] ?? await defaultStore();
    const entry = db.showEntry(store, label);
    if (!entry) {
      console.log(`No memory labeled "${label}" in "${store}".`);
    } else {
      console.log(`[${store}] ${entry.label}`);
      if (entry.branch) console.log(`branch: ${entry.branch}`);
      if (entry.confidence) console.log(`confidence: ${entry.confidence}`);
      console.log(`created: ${entry.created_at}  updated: ${entry.updated_at}`);
      console.log();
      // Strip the "# Label\n\n" heading that remember() prepends.
      const body = entry.content.replace(/^# .+\n\n/, "");
      console.log(body);
    }
    break;
  }

  case "forget": {
    if (!args[0]) usage();
    const label = args[0];
    const store = args[1] ?? await defaultStore();
    const ok = db.forgetEntry(store, label);
    console.log(ok ? `[forgotten] ${store} :: ${label}` : `No memory labeled "${label}" in "${store}".`);
    break;
  }

  case "search": {
    if (!args[0]) usage();
    if (args.length > 2) {
      console.error(`error: too many arguments - quote multi-word queries: thatch search "${args.join(" ")}"`);
      process.exit(1);
    }
    const query = args[0];
    const store = args[1] ?? await defaultStore();
    if (args[1] && store !== "all" && !db.listStores().includes(store)) {
      console.error(`error: no store named "${store}" (did you mean to quote the query?)`);
      console.error(`stores: ${db.listStores().join(", ")}`);
      process.exit(1);
    }
    const stores = store === "all" ? [await defaultStore(), "global"] : [store];

    console.error("Loading embedding model...");
    const model = new BgeEmbeddingModel();
    const queryEmb = await model.queryEmbed(query);
    const results = db.recall(stores, queryEmb, { limit: 10 });

    if (results.length === 0) {
      console.log(`No matches for "${query}" in [${stores.join(", ")}].`);
    } else {
      for (const r of results) {
        const score = r._score.toFixed(3);
        const branch = r.branch ? ` branch:${r.branch}` : "";
        const conf = r.confidence ? ` c:${r.confidence}` : "";
        console.log(`[score:${score}] [${r.store}${branch}${conf}] ${r.label}`);
      }
    }
    break;
  }

  case "mcp": {
    // The MCP server manages its own DB connection; close this one first.
    db.close();
    const { runMcpServer } = await import("../src/mcp");
    await runMcpServer();
    // runMcpServer blocks until stdin closes; don't fall through to db.close().
    process.exit(0);
  }

  case "reminder": {
    const isJson = args.includes("--json");
    const repo = await defaultStore();
    const worktree = projectDir();
    let hygiene: string | null = null;
    try {
      hygiene = await hygieneReport(db, repo, worktree);
    } catch (err) {
      console.error(`[thatch] hygiene report failed: ${err}`);
    }
    // Chat mail check. SessionStart DOES pass a session id in the hook's
    // stdin JSON (session_id for Claude Code, conversation_id for Cursor),
    // so a hooked session learns its identity at session start, not only at
    // its first prompt. When no payload is coming (manual runs, bare
    // spawns) the read is skipped and the line keeps the old shape: a line
    // only when pending mail exists for registered sessions in this project.
    const hookInput = await readHookInput("reminder");
    const hookSessionID = (hookInput?.session_id as string | undefined) ?? (hookInput?.conversation_id as string | undefined);
    const chatLine = await chatHookLine(hookSessionID, hookInput?.transcript_path as string | undefined);
    // Claude Code identity anchor: hooks and the MCP server are children of
    // the same claude process, so recording (parent pid -> session) lets the
    // server resolve the caller without trusting the model's `as`. Recorded
    // only for payloads with session_id (Claude Code) - Cursor's hooks come
    // from a shared extension host where ppid is ambiguous. CLAUDE_CODE_
    // SESSION_ID env in the server process is the spawn-time fallback.
    if (hookInput?.session_id && chatLine) {
      try {
        db.recordChatHostPid(process.ppid, mcpSessionID(String(hookInput.session_id)));
      } catch (err) {
        console.error(`[thatch] chat host-pid anchor failed: ${err}`);
      }
    }
    const reminder = claudeSessionStartReminder(repo, hygiene) + (chatLine ? `\n\n${chatLine}` : "");
    if (isJson) {
      console.log(JSON.stringify({ additional_context: reminder }));
    } else {
      console.log(reminder);
    }
    break;
  }

  case "hygiene": {
    const repo = await defaultStore();
    const worktree = projectDir();
    const hygiene = await hygieneReport(db, repo, worktree);
    console.log(hygiene ?? "Store is healthy.");
    break;
  }

  case "prime": {
    const primerPrompt = "Load the thatch-project-primer skill and follow its instructions to prime this project's memory store.";
    const opencodeBin = Bun.which("opencode");
    const agentBin = Bun.which("agent");
    const claudeBin = Bun.which("claude");

    if (opencodeBin) {
      console.error("Priming project memory via opencode...");
      const proc = Bun.spawnSync([opencodeBin, "run", primerPrompt], {
        stdout: "inherit",
        stderr: "inherit",
      });
      process.exit(proc.exitCode ?? 1);
    } else if (agentBin) {
      // Cursor CLI: -p for non-interactive print mode, --approve-mcps to
      // auto-approve the thatch MCP server (no interactive UI in -p mode).
      console.error("Priming project memory via cursor agent...");
      const proc = Bun.spawnSync([agentBin, "-p", primerPrompt, "--approve-mcps"], {
        stdout: "inherit",
        stderr: "inherit",
      });
      process.exit(proc.exitCode ?? 1);
    } else if (claudeBin) {
      console.error("Priming project memory via claude...");
      const proc = Bun.spawnSync([claudeBin, primerPrompt], {
        stdout: "inherit",
        stderr: "inherit",
      });
      process.exit(proc.exitCode ?? 1);
    } else {
      console.error("Error: none of 'opencode', 'agent', or 'claude' found on PATH.");
      console.error("Install one of them to use thatch prime.");
      process.exit(1);
    }
    break;
  }

  case "setup": {
    const isGlobal = args.includes("--global");
    // --local is the default scope; accepted explicitly so the flag the
    // user types always matches what the command does.
    const isLocal = args.includes("--local");
    const isClaude = args.includes("--claude");
    const isCursor = args.includes("--cursor");

    if (isGlobal && isLocal) {
      console.error("Choose one scope: --local or --global.");
      process.exit(1);
    }
    if (!isClaude && !isCursor) {
      console.error("Specify at least one host: --claude and/or --cursor.");
      console.error("Usage: thatch setup --claude [--cursor] [--local|--global]");
      process.exit(1);
    }

    // Resolve the thatch binary path for hooks and MCP config.
    // If `thatch` is on PATH (npm global install, opencode plugin install),
    // use the bare name - it survives updates and works across machines.
    // If not on PATH (local dev checkout), use the absolute path to this script.
    const thatchOnPath = Bun.which("thatch");
    const thatchBin = thatchOnPath ?? resolve(process.argv[1] ?? process.execPath);
    const dir = projectDir();

    // Shared reporting: where skills went and what the pass did, so an
    // idempotent re-run still tells the user something true.
    const printSkills = (result: { skills: { dir: string; added: unknown[]; updated: unknown[]; removed: string[]; unchanged: string[] }; otherScopeSkills: { dir: string; count: number } | null; global: boolean }) => {
      const { added, updated, removed, unchanged } = result.skills;
      console.log(`  Skills:        ${result.skills.dir}`);
      console.log(`                 ${added.length} added, ${updated.length} updated, ${removed.length} removed, ${unchanged.length} unchanged`);
      if (result.otherScopeSkills) {
        const { dir: otherDir, count } = result.otherScopeSkills;
        if (result.global) {
          console.log(`  Note: ${count} thatch skills exist in ${otherDir} (project scope); --global does not update them.`);
        } else {
          console.log(`  Note: ${count} thatch skills remain in ${otherDir} (user scope; not updated by this run). Run setup with --global to refresh them, or remove them if this repo now owns its skills.`);
        }
      }
    };

    if (isClaude) {
      const result = setupClaudeCode(thatchBin, isGlobal, dir);

      console.log(`Thatch setup complete for Claude Code (${isGlobal ? "global" : "project-local"}).`);
      console.log();
      if (result.mcpConfig) {
        console.log(`  MCP config:    ${result.mcpConfig}`);
      }
      console.log(`  Instructions:  ${result.claudeMd}`);
      console.log(`  Hooks:         ${result.settings}`);
      printSkills(result);
      if (result.commands.length > 0) {
        console.log(`  Commands:      ${result.commands.length} written (${result.commands.map((p) => p.split("/").pop()).join(", ")})`);
      }
      console.log();
      if (result.mcpAddCommand) {
        // Global setup cannot write ~/.claude.json directly, so run the
        // registration on the user's behalf. Idempotent: an existing
        // registration is left alone; a missing or failing claude CLI
        // falls back to printing the manual command.
        const reg = await registerClaudeMcpServer(thatchBin);
        if (reg.status === "registered") {
          console.log(`  MCP server:    ${reg.detail}`);
        } else if (reg.status === "already-registered") {
          console.log(`  MCP server:    already registered (claude mcp get thatch to inspect)`);
        } else {
          console.log("To register the MCP server globally, run:");
          console.log(`  ${result.mcpAddCommand}`);
          console.log(`  (${reg.detail})`);
        }
        console.log();
      }
      console.log("Restart Claude Code for the changes to take effect.");
    }

    if (isCursor) {
      const result = setupCursor(thatchBin, isGlobal, dir);

      console.log();
      console.log(`Thatch setup complete for Cursor (${isGlobal ? "global" : "project-local"}).`);
      console.log();
      console.log(`  MCP config:    ${result.mcpConfig}`);
      console.log(`  Instructions:  ${result.agentsMd}`);
      console.log(`  Hooks:         ${result.hooks}`);
      printSkills(result);
      console.log();
      console.log("Restart Cursor for the changes to take effect.");
    }
    break;
  }

  case "session": {
    await sessionCommand(args);
    break;
  }

  case "chat": {
    await chatCommand(args);
    break;
  }

  case "buffer-batch": {
    // PostToolBatch hook: append the batch's tool_calls to the session's
    // JSONL queue. Silent on success - no stdout - so the next model call
    // is not delayed waiting for an exit code-driven message.
    try {
      const raw = await Bun.stdin.text();
      logHookPayload("buffer-batch", raw);
      const data = JSON.parse(raw) as { session_id?: string; tool_calls?: unknown[] };
      if (data.session_id && Array.isArray(data.tool_calls)) {
        const { appendBatch } = await import("../src/extract-queue");
        appendBatch(data.session_id, data.tool_calls as never);
      }
    } catch (err) {
      console.error(`[thatch buffer-batch] failed: ${err}`);
    }
    break;
  }

  case "buffer-tool": {
    // Cursor postToolUse hook: append a single tool interaction to the
    // session's JSONL queue. Cursor fires postToolUse per-tool (no batch
    // equivalent), so this receives one tool at a time. Silent on success.
    // Session ID comes as `conversation_id` in Cursor (vs `session_id` in
    // Claude Code). The tool result field name is not explicitly documented,
    // so we try the most likely candidates.
    try {
      const raw = await Bun.stdin.text();
      logHookPayload("buffer-tool", raw);
      const data = JSON.parse(raw) as {
        conversation_id?: string;
        session_id?: string;
        tool_name?: string;
        tool_input?: Record<string, unknown>;
        tool_use_id?: string;
        tool_result?: string | unknown[];
        tool_response?: string | unknown[];
        result_json?: string;
        result?: string | unknown[];
        output?: string;
      };
      const sessionID = data.conversation_id ?? data.session_id;
      if (sessionID && data.tool_name) {
        const { appendBatch } = await import("../src/extract-queue");
        const response = data.tool_result ?? data.tool_response ?? data.result_json ?? data.result ?? data.output ?? "";
        appendBatch(sessionID, [{
          tool_name: data.tool_name,
          tool_input: data.tool_input ?? {},
          tool_use_id: data.tool_use_id,
          tool_response: response,
        }]);
      }
    } catch (err) {
      console.error(`[thatch buffer-tool] failed: ${err}`);
    }
    break;
  }

  case "flush-tools": {
    // UserPromptSubmit (Claude Code) / beforeSubmitPrompt (Cursor) hook.
    // Three priority tiers:
    //   1. Extraction nudge - buffered tool interactions are queued for fact
    //      extraction (carries the JSON payload for thatch-fact-extractor).
    //   2. Recall nudge - the user's prompt semantically matches existing
    //      memories. Uses the sideband socket to ask the warm MCP server to
    //      embed the prompt and search, avoiding a cold model load here.
    //   3. Write nudge - static "did you learn anything?" fallback for
    //      conversational turns with no tool use and no memory matches.
    // --json wraps output as { additional_context: "..." } for Cursor hooks.
    // Without --json, stdout is plain text (Claude Code style).
    const isJson = args.includes("--json");
    try {
      const raw = await Bun.stdin.text();
      logHookPayload("flush-tools", raw);
      const data = JSON.parse(raw) as {
        session_id?: string;
        conversation_id?: string;
        transcript_path?: string;
        prompt?: string;
        message?: string;
        text?: string;
        user_input?: string;
        input?: string;
      };
      const sessionID = data.session_id ?? data.conversation_id;

      const { peekQueue, getMissedCount, incrementMissedCount } = await import("../src/extract-queue");
      const { extractionNudge, claudeWriteNudge, claudeRecallNudge, predictionNudge, behaviorNudge } = await import("../src/prompts");
      const { detectSkew, readNpmCacheForUpdate } = await import("../src/version-check");

      let repo = "unknown";
      try { repo = await detectRepo(); } catch {}

      // Version checks (best-effort, no network, instant):
      //   - Skew: the running MCP server's version file differs from this
      //     binary's version. Means the user upgraded but didn't restart.
      //   - Update: the npm cache file (written by the MCP server's
      //     background poll) says a newer version is published.
      // The warning is prepended to whatever nudge the tiers below produce.
      // This is the primary delivery channel for version warnings because
      // flush-tools fires on every prompt, including conversational turns
      // with no tool calls.
      const versionWarning = detectSkew(dbPath) ?? readNpmCacheForUpdate(dbPath);
      // Chat check: with a hook session ID this always prints the caller's
      // assigned identity (and its unread count), so the model knows who it
      // is before any chat tool call; with no mail the line says so.
      const chatLine = await chatHookLine(sessionID, data.transcript_path);
      // Claude Code identity anchor (see reminder case): record the
      // parent-process mapping for session_id-bearing (Claude Code)
      // payloads; Cursor's conversation_id stays on the `as` path.
      if (data.session_id && chatLine && sessionID) {
        try {
          db.recordChatHostPid(process.ppid, mcpSessionID(sessionID));
        } catch (err) {
          console.error(`[thatch] chat host-pid anchor failed: ${err}`);
        }
      }

      // Tier 1: extraction nudge. Peek (don't drain) - the queue persists
      // until the agent calls memory_remember, which triggers consumeQueue.
      // If the agent ignores the nudge, the payload grows on the next flush.
      // The nudge carries the session ID, not the full payload — the
      // sub-agent fetches it via get_extraction_payload.
      const interactions = sessionID ? peekQueue(sessionID) : [];
      if (interactions.length > 0) {
        const missed = sessionID ? getMissedCount(sessionID) : 0;
        if (sessionID) incrementMissedCount(sessionID);
        const output = extractionNudge(interactions.length, missed, "mcp__thatch__memory_remember", sessionID ?? "");
        emit(output, versionWarning, isJson, chatLine);
        break;
      }

      // Tier 2: recall nudge + prediction fire via sideband. The prompt text
      // field name varies by host (Claude Code: "prompt", Cursor: undocumented).
      // Both recall and predictions share the same sideband round-trip.
      const promptText = data.prompt ?? data.message ?? data.text ?? data.user_input ?? data.input;
      if (promptText && promptText.length >= 10) {
        const { sidebandMatch, sidebandPredictions, sidebandBehaviors, sidebandSocketPath } = await import("../src/sideband");
        const sockPath = sidebandSocketPath(dbPath);
        const recallThreshold = parseFloat(process.env.THATCH_RECALL_THRESHOLD ?? "0.55");
        const predThreshold = parseFloat(process.env.THATCH_PREDICTION_THRESHOLD ?? "0.60");
        const behaviorThreshold = parseFloat(process.env.THATCH_BEHAVIOR_THRESHOLD ?? "0.60");

        const [matches, predictions, behaviors] = await Promise.all([
          sidebandMatch(sockPath, promptText, [repo, "global"], recallThreshold, 5),
          sidebandPredictions(sockPath, promptText, [repo, "global"], predThreshold, 5),
          sidebandBehaviors(sockPath, promptText, [repo, "global"], behaviorThreshold, 5),
        ]);

        const parts: string[] = [];
        if (matches && matches.length > 0) {
          parts.push(claudeRecallNudge(matches));
        }
        if (predictions && predictions.length > 0) {
          parts.push(predictionNudge(predictions));
        }
        if (behaviors && behaviors.length > 0) {
          parts.push(behaviorNudge(behaviors));
        }

        if (parts.length > 0) {
          const output = parts.join("\n\n");
          emit(output, versionWarning, isJson, chatLine);
          break;
        }
      }

      // Tier 3: static write nudge.
      const output = claudeWriteNudge();
      emit(output, versionWarning, isJson, chatLine);
    } catch (err) {
      console.error(`[thatch flush-tools] failed: ${err}`);
      try {
        const { claudeWriteNudge } = await import("../src/prompts");
        const fallback = claudeWriteNudge();
        if (isJson) {
          console.log(JSON.stringify({ additional_context: fallback }));
        } else {
          console.log(fallback);
        }
      } catch {
        // If even the fallback import fails, do nothing - silent failure is
        // preferable to blocking the user's prompt over an unrelated hook.
      }
    }
    break;
  }

  case "chat-notify": {
    // Stop hook for BOTH MCP hosts; the payload shape tells them apart:
    // Claude Code sends session_id (+ stop_hook_active, background_tasks),
    // Cursor sends conversation_id (+ status, loop_count).
    //
    // Output shapes: Cursor consumes { followup_message } (auto-submitted
    // as the next user message); Claude Code consumes hookSpecificOutput.
    // additionalContext on Stop - a reminder that continues the turn,
    // rendered as hook feedback rather than a hook error. Pointer-only:
    // sender names and a count, never bodies (bodies flow only through
    // the framed chat_read). The nudge text carries the system-
    // notification framing because a follow-up arrives as user input.
    try {
      const hookInput = await readHookInput("chat-notify");
      if (!chatEnabled(loadConfig(dbPath).config)) {
        console.log("{}");
        break;
      }
      const claudeID = typeof hookInput?.session_id === "string" && hookInput.session_id ? String(hookInput.session_id) : null;
      const cursorID = typeof hookInput?.conversation_id === "string" && hookInput.conversation_id ? String(hookInput.conversation_id) : null;

      // Host-specific loop guards.
      if (claudeID) {
        // Never fight the host's loop protections: a stop-hook continuation
        // already in flight ends the turn, and a session paused on
        // background work gets its wake when that work's turn ends -
        // injecting now would interject mid-flight (the mid-turn injection
        // incident class).
        if (hookInput?.stop_hook_active === true) {
          console.log("{}");
          break;
        }
        if (Array.isArray(hookInput?.background_tasks) && hookInput.background_tasks.length > 0) {
          console.log("{}");
          break;
        }
      } else if (cursorID) {
        // Cursor: never auto-continue an aborted or errored turn (the
        // user's stop key wins).
        if (hookInput?.status !== "completed") {
          console.log("{}");
          break;
        }
      } else {
        console.log("{}");
        break;
      }

      // Lookup, not ensure-register: registration exists by the time stop
      // fires (the prompt hooks anchored the conversation), and minting
      // rows from contexts we do not understand is how the throwaway
      // sessionStart identities happened.
      const anchor = mcpSessionID(claudeID ?? cursorID!);
      if (!db.findChatSession(anchor)) {
        console.log("{}");
        break;
      }
      const pending = db
        .pendingChatNotifications([anchor], isoMinutesAgo(CHAT_RENUDGE_MINUTES))
        .filter((m) => m.to_session === anchor);
      if (pending.length === 0) {
        console.log("{}");
        break;
      }
      const senders = [
        ...new Set(pending.map((m) => renderChatParticipant(m.from_name, m.from_session))),
      ];
      // Stamp before emitting: the re-nudge window (not the model's
      // obedience) bounds repeats when the mail goes ignored.
      db.markChatDelivered(pending.map((m) => m.id));
      const nudge = chatNotificationNudge(senders, pending.length);
      console.log(
        JSON.stringify(
          claudeID
            ? { hookSpecificOutput: { hookEventName: "Stop", additionalContext: nudge } }
            : { followup_message: nudge },
        ),
      );
    } catch (err) {
      console.error(`[thatch chat-notify] failed: ${err}`);
      console.log("{}");
    }
    break;
  }

  case "flush-predictions": {
    // UserPromptSubmit (Claude Code) / beforeSubmitPrompt (Cursor) hook.
    // Standalone prediction fire: queries the sideband for scored
    // predictions matching the prompt text, prints the prediction nudge
    // if any matchers fire. --json wraps as { additional_context: "..." }
    // for Cursor hooks. Without --json, stdout is plain text.
    //
    // NOTE: flush-tools already fires predictions alongside the recall
    // nudge in its tier 2 block. This subcommand exists for testing and
    // for hosts that want prediction-only output without the recall or
    // extraction nudges.
    const isJson = args.includes("--json");
    try {
      const raw = await Bun.stdin.text();
      const data = JSON.parse(raw) as {
        prompt?: string;
        message?: string;
        text?: string;
        user_input?: string;
        input?: string;
      };

      const promptText = data.prompt ?? data.message ?? data.text ?? data.user_input ?? data.input;
      if (!promptText || promptText.length < 10) {
        if (isJson) console.log(JSON.stringify({ additional_context: "" }));
        break;
      }

      let repo = "unknown";
      try { repo = await detectRepo(); } catch {}

      const { sidebandPredictions, sidebandSocketPath } = await import("../src/sideband");
      const { predictionNudge } = await import("../src/prompts");
      const sockPath = sidebandSocketPath(dbPath);
      const threshold = parseFloat(process.env.THATCH_PREDICTION_THRESHOLD ?? "0.60");
      const predictions = await sidebandPredictions(sockPath, promptText, [repo, "global"], threshold, 5);

      if (predictions && predictions.length > 0) {
        const output = predictionNudge(predictions);
        if (isJson) console.log(JSON.stringify({ additional_context: output }));
        else console.log(output);
      } else {
        if (isJson) console.log(JSON.stringify({ additional_context: "" }));
      }
    } catch (err) {
      console.error(`[thatch flush-predictions] failed: ${err}`);
    }
    break;
  }

  default:
    usage();
}

db.close();
