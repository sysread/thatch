#!/bin/sh
# The thatch launcher: picks the runtime by PROBED capability, not by
# PATH name alone (docs/plans/node-sqlite-driver.md, D12). Every row
# must resolve without a login shell - hook hosts spawn this file
# directly, shebang honored. The dist-existence test is load-bearing:
# the Nix package ships no dist/ (no bundle step in the derivation), so
# a capable system node must fall through to the bun row instead of
# exec'ing a nonexistent file.
root=$(CDPATH= cd "$(dirname "$0")/.." && pwd)

# Row 1: a node on PATH whose node:sqlite actually resolves - the probe,
# not the name: node 22.5-22.12 ships the module behind a flag and would
# die at import - plus the bundled dist (bin/thatch.ts bundled by
# prepack). A node that fails the probe is treated as absent.
if command -v node >/dev/null 2>&1; then
    if node -e 'require("node:sqlite")' >/dev/null 2>&1 && [ -f "$root/dist/thatch.js" ]; then
        exec node "$root/dist/thatch.js" "$@"
    fi
fi

# Row 2: a bun on PATH runs the TypeScript source.
if command -v bun >/dev/null 2>&1; then
    exec bun "$root/bin/thatch.ts" "$@"
fi

# Row 3: the @oven binary the plugin's dependencies installed (the `bun`
# npm package's platform binary; the .bin shims stay unwired because
# plugin dependency installs run with --ignore-scripts). Last resort.
for oven in "$root"/node_modules/@oven/bun-*/bin/bun; do
    if [ -x "$oven" ]; then
        exec "$oven" "$root/bin/thatch.ts" "$@"
    fi
done

# Row 4: nothing usable - fail loudly with the missing prerequisites.
echo "thatch: no usable JavaScript runtime found" >&2
echo "  one of these must hold:" >&2
echo "  - node >= 22.13 on PATH (its node:sqlite is probed directly) with dist/thatch.js bundled" >&2
echo "  - bun >= 1.4.2 on PATH" >&2
echo "  - the @oven binary under $root/node_modules (installed with the plugin's dependencies)" >&2
exit 1
