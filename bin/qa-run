#!/usr/bin/env bash
set -euo pipefail

# Wrapper for running a subset of QA use cases by UC name.
# Usage: qa-run <auto|live> [uc-NNN ...]
# Examples:
#   qa-run auto uc-004 uc-008
#   qa-run live uc-001 uc-003

mode="${1:-auto}"
shift

# Auto-suite concurrency, overridable with QA_CONCURRENCY=N. Default 2:
# each concurrent use case that spawns opencode (docker mode wraps every
# spawn in its own container) loads a private plugin instance and
# embedding model - fixture db paths do not share the model pool - so
# 5-way runs spike host memory hard enough to OOM the opencode service
# hosting live sessions. 2 keeps most of the parallel speed without the
# spike; QA_CONCURRENCY=1 serializes completely.
conc="${QA_CONCURRENCY:-2}"

if [ "$#" -eq 0 ]; then
  # No args: run all
  if [ "$mode" = "auto" ]; then
    exec bun test tests/qa/auto/index.test.ts --concurrent --max-concurrency "$conc"
  else
    exec bun test tests/qa/live/index.test.ts
  fi
fi

# Build a regex from UC name args: uc-004 uc-008 -> ^(UC-004|UC-008)
# Test names are capitalized (UC-NNN), args may be lowercase.
pattern=""
for arg in "$@"; do
  # Capitalize the first two chars (uc -> UC) to match test names
  uc=$(echo "$arg" | sed 's/^uc/UC/')
  if [ -n "$pattern" ]; then
    pattern="${pattern}|"
  fi
  pattern="${pattern}${uc}"
done

if [ "$mode" = "auto" ]; then
  exec bun test tests/qa/auto/index.test.ts --concurrent --max-concurrency "$conc" --test-name-pattern "^(${pattern})"
else
  exec bun test tests/qa/live/index.test.ts --test-name-pattern "^(${pattern})"
fi
