{
  "name": "thatch",
  "owner": {
    "name": "Jeff Ober",
    "url": "https://github.com/sysread/thatch"
  },
  "description": "Persistent memory for Claude Code: local embeddings, SQLite stores, cross-session chat.",
  "plugins": [
    {
      "name": "thatch",
      "description": "Thatch memory, extraction, and cross-session chat for Claude Code.",
      "strict": true,
      "source": {
        "source": "github",
        "repo": "sysread/thatch",
        "ref": "plugin-release"
      },
      "mcpServers": {
        "thatch": {
          "type": "stdio",
          "command": "bun",
          "args": [
            "${CLAUDE_PLUGIN_ROOT}/bin/thatch",
            "mcp",
            "--bundled"
          ]
        }
      }
    }
  ]
}
