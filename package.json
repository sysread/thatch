{
  "name": "@jeffober/thatch",
  "version": "0.5.2",
  "description": "Persistent memory for AI coding agents — local embeddings, SQLite stores, zero config. Works with OpenCode (as a plugin), Claude Code (as an MCP server), and Cursor (as an MCP server).",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/opencode/tui-plugin.ts"
  },
  "bin": {
    "thatch": "./bin/thatch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sysread/thatch.git"
  },
  "files": [
    "src",
    "dist",
    "docs",
    "bin",
    "artifacts",
    "hooks",
    ".claude-plugin/plugin.json",
    "npm-shrinkwrap.json"
  ],
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "onnxruntime-web": "1.26.0-dev.20260416-b7804b056c",
    "zod": "4.1.8"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.1.1"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "claude-code",
    "mcp",
    "mcp-server",
    "memory",
    "embeddings",
    "sqlite"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0",
    "bun": ">=1.4.2"
  }
}
